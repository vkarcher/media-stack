# ==============================================================================
#  Paramètres de la stack — copiez ce fichier en .env et remplissez-le
# ==============================================================================
#  Le .env n'est jamais versionné (voir .gitignore). Les seuls secrets qui y
#  vivent sont ceux nécessaires à l'interpolation par docker compose ; le reste
#  va dans secrets/ (voir docs/securite.md).
# ==============================================================================

# --- Identité ----------------------------------------------------------------
# Votre domaine. Les sous-domaines publics seront <service>.$DOMAIN et les
# privés <service>.lan.$DOMAIN (voir docs/reverse-proxy.md).
DOMAIN=exemple.com

# Sous-domaines des deux services exposés publiquement.
JELLYFIN_SUBDOMAIN=stream
SEERR_SUBDOMAIN=request

# IP privée du serveur. Cible de l'enregistrement DNS *.lan.$DOMAIN
SERVER_LAN_IP=192.168.1.10

# --- Chemins -----------------------------------------------------------------
# Racine de la stack : compose, appdata, secrets, sauvegardes.
# Sur un SSD/NVMe : bases de données et configuration.
STACK_ROOT=/srv/homelab

# Racine du pool média. UN SEUL point de montage contenant media/ ET torrents/.
# C'est la condition des hardlinks — lisez docs/hardlinks.md avant de changer.
POOL_ROOT=/mnt/pool

# --- Permissions -------------------------------------------------------------
# UID/GID utilisés par TOUS les conteneurs. Doivent posséder POOL_ROOT.
PUID=1000
PGID=1000
TZ=Europe/Paris
UMASK=002

# --- VPN (gluetun) -----------------------------------------------------------
# Fournisseurs supportés : https://github.com/qdm12/gluetun-wiki
VPN_SERVICE_PROVIDER=nordvpn
VPN_TYPE=wireguard
SERVER_COUNTRIES=Switzerland
WIREGUARD_PRIVATE_KEY=

# Optionnel — résolution DNS forcée pour un tracker dont le DNS est instable.
# Format : "hote:ip". Laisser vide si inutile.
# Voir docs/pieges.md, section « tracker injoignable ».
TRACKER_HOST_ENTRY=

# --- Ports publiés sur l'hôte ------------------------------------------------
# Seuls le reverse proxy et le port torrent sont publiés. Tout le reste passe
# par le réseau Docker (voir docs/architecture.md).
NPM_HTTP_PORT=80
NPM_HTTPS_PORT=443
NPM_ADMIN_PORT=81
QBITTORRENT_WEBUI_PORT=8080
TORRENT_PORT=6881

# ⚠️ Si le port 80 de l'hôte est déjà occupé (certains OS de NAS y mettent leur
#    interface), changez NPM_HTTP_PORT (ex. 8180) et faites pointer la
#    redirection WAN 80 dessus. Voir docs/reverse-proxy.md.
