# ==========================================
# ⚙️ CONFIGURATION GÉNÉRALE (TOUCHEZ ICI)
# ==========================================

# 1. Votre fuseau horaire
# Pour la France : Europe/Paris
TZ=Europe/Paris

# 2. Identifiants Utilisateur/Groupe (Synology)
# Pour trouver ces IDs, connectez-vous en SSH et tapez : id
# PUID = User ID (ex: 1026 pour le premier admin)
# PGID = Group ID (ex: 100 pour "users")
PUID=1026
PGID=100

# 3. Dossier Racine
# L'endroit où toutes vos données seront stockées sur le NAS.
# Le script setup.sh créera les sous-dossiers dans ce répertoire.
ROOT_DIR=/volume1

# ==========================================
# 🔌 PORTS DES APPLICATIONS
# (Modifiez seulement si vous avez des conflits)
# ==========================================

# Dashboard
HOMARR_PORT=7575

# Média & Demandes
JELLYFIN_PORT=8096
JELLYSEERR_PORT=5055

# Téléchargement
QBITTORRENT_WEBUI_PORT=8080
QBITTORRENT_P2P_PORT=6881

# Automatisation
RADARR_PORT=7878
SONARR_PORT=8989
BAZARR_PORT=6767
PROWLARR_PORT=9696

# Outils
FLARESOLVERR_PORT=8191
